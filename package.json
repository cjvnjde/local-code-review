{
  "name": "local-code-review",
  "version": "1.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun ./src/index.ts",
    "dev": "bun --watch ./src/index.ts --no-open",
    "demo:web": "bun ./scripts/web-playground.ts",
    "test": "bun test ./src",
    "test:coverage": "bun test ./src --coverage",
    "test:mutation": "bunx --package @stryker-mutator/core@10.1.1 stryker run",
    "check": "bun run typecheck && bun test ./src && bun run scripts/build.ts --bundle --outfile /tmp/lcr-check",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "konva": "^10.9.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "remark-gfm": "^4.0.1",
    "remark-breaks": "^4.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}

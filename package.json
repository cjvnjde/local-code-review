{
  "name": "local-code-review",
  "version": "2.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun ./src/index.ts",
    "dev": "bun --watch ./src/index.ts --no-open",
    "demo:web": "bun ./scripts/web-playground.ts",
    "test": "bun test ./src",
    "test:coverage": "bun test ./src --coverage",
    "test:mutation": "bunx --package @stryker-mutator/core@10.1.1 stryker run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:skills && bun test ./src && bun run scripts/build.ts --bundle --outfile /tmp/lcr-check",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "lint:fix": "bunx --bun eslint . --fix --max-warnings 0",
    "format": "prettier --write --no-config --no-editorconfig .",
    "format:check": "prettier --check --no-config --no-editorconfig .",
    "check:skills": "diff -r skills/apply-lcr .agents/skills/apply-lcr"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.7.0",
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "axe-core": "^4.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^12.0.0",
    "konva": "^10.9.1",
    "lucide-react": "^1.72.0",
    "perfect-freehand": "1.2.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "^1.4.4",
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "devtools-protocol": "0.0.1744848",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
